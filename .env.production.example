# Copiar a .env.production en el droplet (NUNCA commitear .env.production).
# Lo leen ambos servicios de docker-compose.prod.yml.
#
# Sin comillas en los valores: `docker run --env-file` (usado para el seed) las pasa literales.
# Contraseñas: usa solo letras y números (p. ej. `openssl rand -hex 24`). Así no hay
# que escaparlas en DATABASE_URL ni las altera la interpolación de docker compose ($).

NODE_ENV=production
PORT=4000

# --- MySQL (contenedor eunikmoda_db) ---
# La imagen oficial de mysql crea la base y el usuario con estos valores solo la
# primera vez (volumen vacío). Cambiarlos después no modifica una base ya creada.
MYSQL_DATABASE=eunikmoda
MYSQL_USER=eunikmoda
MYSQL_PASSWORD=cambiar_password_app
MYSQL_ROOT_PASSWORD=cambiar_password_root

# Host = eunikmoda_db (nombre del servicio en docker compose, se resuelve por la red
# interna eunikmoda_net), NO localhost. Usuario/password/base = los MYSQL_* de arriba.
DATABASE_URL=mysql://eunikmoda:cambiar_password_app@eunikmoda_db:3306/eunikmoda

# --- Auth ---
# Genera uno NUEVO para producción, distinto al de desarrollo: `openssl rand -base64 48`
JWT_SECRET=generar-uno-nuevo-distinto-al-de-desarrollo
JWT_EXPIRES_IN=8h

# --- Frontend (Vercel) ---
# Dominio real del frontend, con https y sin "/" final.
CORS_ORIGIN=https://tu-proyecto.vercel.app
FRONTEND_URL=https://tu-proyecto.vercel.app

# --- Uploads --- (relativo a /app; montado como volumen en ./uploads del droplet)
UPLOADS_DIR=uploads

# --- Email (Resend) ---
RESEND_API_KEY=re_tu_api_key_de_resend
RESEND_FROM_EMAIL=EUNIKMODA <novedades@eunikmoda.cl>
