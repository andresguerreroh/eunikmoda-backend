NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=eunikmoda
DB_PASSWORD=changeme
DB_NAME=eunikmoda

# Usada por Prisma (CLI y runtime). Formato: mysql://USER:PASSWORD@HOST:PORT/DBNAME
# Las DB_* de arriba quedan solo como referencia.
DATABASE_URL="mysql://eunikmoda:changeme@localhost:3306/eunikmoda"

JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:3000
UPLOADS_DIR=uploads

FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=re_tu_api_key_de_resend
RESEND_FROM_EMAIL=EUNIKMODA <novedades@eunikmoda.cl>
